+class WarpBvhRefitCommandBundle:
+    """Immutable pre-recorded Warp refit commands for one storage graph."""
+
+    __slots__ = (
+        "_commands",
+        "_poisoned",
+        "_sealed",
+        "bvh",
+        "evidence",
+        "stream",
