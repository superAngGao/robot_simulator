+    if not rotation_view.is_contiguous() or not translation_view.is_contiguous():
+        raise ValueError("CUDA replay frame views must be contiguous")
+    return CudaSceneTransformInputs(
+        x_world_R=rotation_view,
+        x_world_r=translation_view,
+        env_idx=0,
+        input_contract=input_contract,
