+
+    torch = _torch_module()
+    if not isinstance(frame_index, int) or isinstance(frame_index, bool) or frame_index < 0:
+        raise ValueError("transform replay frame index must be a non-negative integer")
+    if not input_contract or not _sha256_text(transform_replay_sha256):
+        raise ValueError("transform replay provenance must be non-empty")
+    if not isinstance(x_world_R, torch.Tensor) or not isinstance(x_world_r, torch.Tensor):
+        raise TypeError("CUDA replay transforms must be Torch tensors")
+    if not x_world_R.is_cuda or not x_world_r.is_cuda or x_world_R.device != x_world_r.device:
+        raise ValueError("CUDA replay transforms must share one CUDA device")
+    if x_world_R.dtype != torch.float32 or x_world_r.dtype != torch.float32:
+        raise ValueError("CUDA replay transforms must use float32")
+    if tuple(x_world_R.shape[2:]) != (3, 3) or tuple(x_world_r.shape[2:]) != (3,):
+        raise ValueError("CUDA replay transform trailing shapes are invalid")
+    if tuple(x_world_R.shape[:2]) != tuple(x_world_r.shape[:2]):
+        raise ValueError("CUDA replay transform frame/env dimensions do not agree")
+    if x_world_R.dim() != 4 or x_world_r.dim() != 3:
+        raise ValueError("CUDA replay transform ranks are invalid")
+    if not x_world_R.is_contiguous() or not x_world_r.is_contiguous():
+        raise ValueError("CUDA replay transforms must be contiguous")
+    if frame_index >= int(x_world_R.shape[0]):
+        raise IndexError("transform replay frame index is out of range")
+    rotation_view = x_world_R[frame_index : frame_index + 1]
