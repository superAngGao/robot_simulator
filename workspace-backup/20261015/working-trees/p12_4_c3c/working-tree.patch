+class CudaSceneUpdateStage:
+    """One immutable allocation-free scene-update transaction stage."""
+
+    cuda_transaction_stage_name = "cuda_scene_update"
+
+    __slots__ = (
+        "_binding_signature",
+        "_plane_args",
+        "_plane_entry",
+        "_sealed",
+        "_triangle_args",
+        "_triangle_entry",
+        "evidence",
+        "factory",
+        "outputs",
+        "transforms",
+    )
+
+    def __init__(
+        self,
+        *,
+        factory: CudaSceneUpdateStageFactory,
+        transforms: CudaSceneTransformInputs,
+        outputs: CudaWorldSceneBuffers,
+        triangle_entry: object | None,
+        triangle_args: tuple[object, ...],
+        plane_entry: object | None,
+        plane_args: tuple[object, ...],
+        evidence: CudaSceneUpdateStageEvidence,
+    ) -> None:
+        self._sealed = False
+        self.factory = factory
+        self.transforms = transforms
+        self.outputs = outputs
+        self._triangle_entry = triangle_entry
+        self._triangle_args = triangle_args
+        self._plane_entry = plane_entry
+        self._plane_args = plane_args
+        self.evidence = evidence
+        self._binding_signature: tuple[object, ...] | None = None
+
+    def __setattr__(self, name: str, value: object) -> None:
+        if getattr(self, "_sealed", False) or getattr(
+            self, "_binding_signature", None
+        ) is not None:
+            raise AttributeError("CUDA scene-update stage is immutable")
+        object.__setattr__(self, name, value)
+
+    def __delattr__(self, name: str) -> None:
+        raise AttributeError("CUDA scene-update stage is immutable")
+
+    @property
+    def dispatch_count(self) -> int:
+        return self.evidence.dispatch_count
+
+    def enqueue(self, transaction: object) -> None:
+        """Enqueue only the fixed entries and arguments on the transaction stream."""
+
+        with transaction.enqueue_stage(self):
+            transaction.record_diagnostic_start("scene_update_kernel")
+            if self._triangle_entry is not None:
+                self._triangle_entry(*self._triangle_args)
+            if self._plane_entry is not None:
+                self._plane_entry(*self._plane_args)
+            transaction.record_diagnostic_end("scene_update_kernel")
+
+    def _validate_cuda_transaction_stage(self, context: object) -> None:
+        if context is not self.factory.context:
+            raise ValueError("CUDA scene stage execution context identity mismatch")
+        self.factory._assert_stable()
+        _validate_transform_inputs(self.factory.local_scene, self.transforms, context.device)
+        _validate_world_outputs(self.factory.local_scene, self.outputs, context.device)
+        _validate_storage_disjointness(
+            _scene_input_items(self.factory.local_scene, self.transforms),
+            self.outputs.tensor_items(),
+        )
+        expected_triangle = (
+            self.factory._triangle_entry if self.factory.local_scene.num_triangles else None
+        )
+        expected_plane = (
+            self.factory._plane_entry if self.factory.local_scene.num_planes else None
+        )
+        if self._triangle_entry is not expected_triangle or self._plane_entry is not expected_plane:
+            raise ValueError("CUDA scene stage extension entry identity changed")
+        _validate_triangle_abi_binding(self)
+        _validate_plane_abi_binding(self)
+        _validate_scene_stage_evidence(self)
+
+    def _freeze(self) -> None:
+        if self._sealed or self._binding_signature is not None:
+            raise RuntimeError("CUDA scene-update stage seal is one-way")
+        object.__setattr__(self, "_binding_signature", self._stage_signature())
+        object.__setattr__(self, "_sealed", True)
+
+    def _assert_cuda_transaction_stage_stable(self, context: object) -> None:
+        if context is not self.factory.context:
+            raise ValueError("CUDA scene stage execution context changed")
