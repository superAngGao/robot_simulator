+    torch::ScalarType dtype,
+    const char* name) {
+  TORCH_CHECK(value.is_cuda(), name, " must be CUDA");
+  TORCH_CHECK(value.device() == device, name, " must be on the anchor device");
+  TORCH_CHECK(value.scalar_type() == dtype, name, " has the wrong dtype");
