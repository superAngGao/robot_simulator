+    The factory is comparison infrastructure, not a product executor and not a
+    C4 result capability.  C4 may later use it to seal final arena slots, but
+    only after those slots and their leases exist.
+    """
+
+    __slots__ = (
+        "_frozen_signature",
+        "_sealed",
+        "acceleration_class",
+        "context",
+        "cuda_lbvh_factory",
+        "external_stream",
+        "prepared",
+        "scene_factory",
+        "stream",
+    )
