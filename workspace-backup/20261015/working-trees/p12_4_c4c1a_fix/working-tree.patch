+        or storage_nbytes < 0
+        or active_start < 0
+        or active_count < 0
+        or active_start + active_count > storage_nbytes
+        or (storage_nbytes > 0 and base_pointer <= 0)
+        or (storage_nbytes > 0 and storage_identity <= 0)
+    ):
+        raise ValueError("prepared native array has invalid physical CUDA storage")
+    return (
